# VLM 端点凭证 — 复制为 .env 并填写。.env 已被 .gitignore 排除, 永远不要提交。
#
# 传输协议: Anthropic Messages (/v1/messages, 多模态 content 块)
# 也接受 ANTHROPIC_* / DEEPSEEK_* 作为别名, 方便对接不同网关。

VLM_BASE_URL=https://api.anthropic.com
VLM_API_KEY=sk-ant-...
VLM_MODEL=claude-sonnet-5

# 文本 LLM 规划器 (可选; configs/planner_model.json 定义的 OPENAI_* 口径)
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-flash
